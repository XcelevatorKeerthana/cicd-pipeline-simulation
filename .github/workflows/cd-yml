name: Continuous Dependent CI/CD Pipelines 

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:

  build:
    name: Build Application
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Build
        run: mvn clean package -DskipTests

  scan:
    name: Security Scan
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Run security scan
        run: echo "Security scan successful"

  test:
    name: Run Tests
    runs-on: ubuntu-latest
    needs: scan
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Run tests
        run: mvn test

  release:
    name: Release Artifact
    runs-on: ubuntu-latest
    needs: test
    steps:
      - name: Create release
        run: echo "Release completed"

  deploy-dev:
    name: Deploy to DEV
    runs-on: ubuntu-latest
    needs: release
    environment: dev
    steps:
      - run: echo "Deployed to DEV"

  deploy-sit:
    name: Deploy to SIT
    runs-on: ubuntu-latest
    needs: deploy-dev
    environment: sit
    steps:
      - run: echo "Deployed to SIT"

  deploy-preprod:
    name: Deploy to Pre-Prod
    runs-on: ubuntu-latest
    needs: deploy-sit
    environment: preprod
    steps:
      - run: echo "Deployed to Pre-Prod"

  deploy-prod:
    name: Deploy to PROD
    runs-on: ubuntu-latest
    needs: deploy-preprod
    environment: prod
    steps:
      - run: echo "Deployed to PROD"  


